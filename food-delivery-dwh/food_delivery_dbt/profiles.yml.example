# Copy to ~/.dbt/profiles.yml (merge with existing profiles if needed).
# Never commit real credentials or private keys.

food_delivery_dbt:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: YOUR_ACCOUNT_ID          # e.g. xy12345.eu-west-1 (see Snowflake docs)
      user: YOUR_DBT_USER
      role: SYSADMIN
      database: sandbox
      warehouse: adhoc_wh
      schema: clean_sch
      threads: 4
      authenticator: snowflake_jwt
      private_key_path: C:/path/to/your/dbt_key.p8
      # private_key_passphrase: optional if key is encrypted
