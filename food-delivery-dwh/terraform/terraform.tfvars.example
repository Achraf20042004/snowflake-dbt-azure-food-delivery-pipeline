# COPY this file to terraform.tfvars and fill in your real values.
# terraform.tfvars is gitignored — never commit real credentials.

snowflake_organization = "YOUR_ORG_NAME"
snowflake_account      = "YOUR_ACCOUNT_ID"
snowflake_user         = "TERRAFORM_SVC"
private_key_path       = "C:/path/to/your/snowflake/tf_key.p8"
azure_subscription_id  = "00000000-0000-0000-0000-000000000000"
azure_tenant_id        = "00000000-0000-0000-0000-000000000000"
azure_location         = "francecentral"
